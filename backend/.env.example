PROJECT_NAME="Secure Wealth Twin"
PROJECT_VERSION="1.0.0"
ENVIRONMENT="development"
API_VERSION="v1"

# Database Connection (PostgreSQL)
# e.g., local PostgreSQL or Supabase pooler URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/securewealth_db"

# Authentication & JWT
JWT_SECRET_KEY="replace_this_with_a_long_random_secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
LOGIN_METHODS="CUSTOMER_ID"

# Admin Dashboard
ADMIN_API_KEY="securewealth-admin-2026"
REDTEAM_ENABLED=true
